{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Trebuchet",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wcast-align",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wnull-dereference",
                "-g3",
                "-O0",
                "-c",
                "${workspaceFolder}/Trebuchet/WIPPER_TREBUCHET/Simulation_Code.cpp",
                "-o",
                "${workspaceFolder}/build/Debug/Simulation_Code.o"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Link Trebuchet",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wcast-align",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wnull-dereference",
                "-g3",
                "-O0",
                "${workspaceFolder}/build/Debug/Simulation_Code.o",
                "-o",
                "${workspaceFolder}/build/Debug/outDebug.exe",
                "-lgdiplus",
                "-luser32",
                "-lgdi32",
                "-lole32",
                "-loleaut32"
            ],
            "dependsOn": ["Build Trebuchet"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
